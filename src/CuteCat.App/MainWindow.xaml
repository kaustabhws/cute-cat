<Window x:Class="CuteCat.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cute Cat" Width="900" Height="700" MinWidth="780" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource Paper}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,23,32,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M 2,24 C 0,19 2,13 5,10 L 5,2 Q 6,-1 10,4 L 14,8 Q 20,6 24,8 L 30,2 Q 34,0 33,6 L 33,13 C 38,20 33,30 23,30 L 12,30 Q 3,29 2,24 Z" Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Width="34" Height="31" Stretch="Uniform" Margin="0,0,11,0"/>
          <TextBlock Text="cute cat" FontFamily="Georgia" FontSize="24" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel x:Name="Navigation" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0"/>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="Page" HorizontalAlignment="Left" Margin="36,29,36,24"/></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,13">
      <DockPanel><TextBlock x:Name="Footer" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="Free · Local · Made for Windows" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}"/></DockPanel>
    </Border>
  </Grid>
</Window>
